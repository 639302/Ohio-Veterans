{
  "name": "@mms/design-system",
  "version": "0.19.0",
  "description": "Maximus Design System - Enterprise web component library for government digital experiences",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "customElements": "custom-elements.json",
  "sideEffects": [
    "*.css",
    "**/*.component.js",
    "**/*.component.ts"
  ],
  "files": [
    "dist/",
    "custom-elements.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/mms-alert-banner": {
      "types": "./dist/components/alert-banner/mms-alert-banner.component.d.ts",
      "default": "./dist/components/alert-banner/mms-alert-banner.component.js"
    },
    "./components/mms-button": {
      "types": "./dist/components/button/mms-button.component.d.ts",
      "default": "./dist/components/button/mms-button.component.js"
    },
    "./components/mms-checkbox": {
      "types": "./dist/components/checkbox/mms-checkbox.component.d.ts",
      "default": "./dist/components/checkbox/mms-checkbox.component.js"
    },
    "./components/mms-checkbox-group": {
      "types": "./dist/components/checkbox-group/mms-checkbox-group.component.d.ts",
      "default": "./dist/components/checkbox-group/mms-checkbox-group.component.js"
    },
    "./components/mms-icon": {
      "types": "./dist/components/icon/mms-icon.component.d.ts",
      "default": "./dist/components/icon/mms-icon.component.js"
    },
    "./components/mms-link": {
      "types": "./dist/components/link/mms-link.component.d.ts",
      "default": "./dist/components/link/mms-link.component.js"
    },
    "./components/mms-modal": {
      "types": "./dist/components/modal/mms-modal.component.d.ts",
      "default": "./dist/components/modal/mms-modal.component.js"
    },
    "./components/mms-radio": {
      "types": "./dist/components/radio/mms-radio.component.d.ts",
      "default": "./dist/components/radio/mms-radio.component.js"
    },
    "./components/mms-radio-group": {
      "types": "./dist/components/radio-group/mms-radio-group.component.d.ts",
      "default": "./dist/components/radio-group/mms-radio-group.component.js"
    },
    "./components/mms-select": {
      "types": "./dist/components/select/mms-select.component.d.ts",
      "default": "./dist/components/select/mms-select.component.js"
    },
    "./components/mms-text-area": {
      "types": "./dist/components/text-area/mms-text-area.component.d.ts",
      "default": "./dist/components/text-area/mms-text-area.component.js"
    },
    "./components/mms-text-field": {
      "types": "./dist/components/text-field/mms-text-field.component.d.ts",
      "default": "./dist/components/text-field/mms-text-field.component.js"
    },
    "./components/mms-toggle": {
      "types": "./dist/components/toggle/mms-toggle.component.d.ts",
      "default": "./dist/components/toggle/mms-toggle.component.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./themes/default": {
      "import": "./dist/themes/default.css",
      "default": "./dist/themes/default.css"
    },
    "./themes/default-dark": {
      "import": "./dist/themes/default-dark.css",
      "default": "./dist/themes/default-dark.css"
    },
    "./themes/maximus": {
      "import": "./dist/themes/maximus.css",
      "default": "./dist/themes/maximus.css"
    },
    "./themes/maximus-dark": {
      "import": "./dist/themes/maximus-dark.css",
      "default": "./dist/themes/maximus-dark.css"
    },
    "./themes/va-gov": {
      "import": "./dist/themes/va-gov.css",
      "default": "./dist/themes/va-gov.css"
    },
    "./themes/va-gov-dark": {
      "import": "./dist/themes/va-gov-dark.css",
      "default": "./dist/themes/va-gov-dark.css"
    },
    "./tokens.css": {
      "import": "./dist/styles/tokens.css",
      "default": "./dist/styles/tokens.css"
    }
  },
  "publishConfig": {
    "registry": "https://artifactory.mars.pcf-maximus.com/artifactory/api/npm/mms-ds-platform/"
  },
  "scripts": {
    "build": "npm run build-package && npm run analyze",
    "build-package": "node scripts/build-package.mjs",
    "build-tokens": "echo 'DEPRECATED: CSS is now source of truth. See tokens-archive/ for reference.'",
    "analyze": "cem analyze --litelement",
    "generate-exports": "node scripts/generate-exports.mjs",
    "storybook": "storybook dev -p ${STORYBOOK_PORT:-6006}",
    "build-storybook": "storybook build",
    "predeploy": "DEPLOY_TARGET=gh-pages npm run build-storybook && node patch-storybook.cjs",
    "deploy": "gh-pages -d storybook-static --repo https://github.com/638088/mms-ds-storybook.git",
    "test": "npm run test:unit && npm run test:a11y",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:a11y": "playwright test",
    "test:a11y:ui": "playwright test --ui",
    "validate:tokens": "node scripts/validate-tokens.mjs",
    "validate:tracker": "node scripts/validate-tracker.mjs",
    "audit:hardcoded": "node scripts/audit-hardcoded-values.mjs",
    "audit:contrast": "node scripts/contrast-audit.mjs",
    "audit:a11y-coverage": "node scripts/audit-a11y-coverage.mjs",
    "build-wcag-tables": "node scripts/build-wcag-tables.mjs",
    "verify-bundle": "node scripts/verify-bundle.mjs",
    "prepublishOnly": "npm run build",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "release:dry-run": "standard-version --dry-run",
    "prepare": "husky || true"
  },
  "peerDependencies": {
    "lit": "^3.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@mdx-js/rollup": "^3.1.1",
    "@open-wc/testing": "^5.0.0",
    "@phosphor-icons/core": "^2.1.1",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/web-components-vite": "^10.4.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.0",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lit": "^3.0.0",
    "playwright": "^1.61.1",
    "standard-version": "^9.5.0",
    "storybook": "^10.4.0",
    "style-dictionary": "^5.5.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "design-system",
    "web-components",
    "lit",
    "maximus",
    "government",
    "wcag",
    "accessibility"
  ],
  "author": "Maximus Digital Experience Practice",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/maximus-inc/mms-ds-platform.git"
  },
  "dependencies": {
    "@lit/react": "^1.0.8"
  }
}
